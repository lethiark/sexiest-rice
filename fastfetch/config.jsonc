{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/images/void.txt",
    "color": {
      "1": "#006400"
    },
    "padding": {
      "top": 4,
      "right": 6,
      "left": 3
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "keyWidth": 10,
      "color": "#2C2D2D"
    },
    "break",
    {
      "type": "os",
      "key": " ",
      "keyColor": "#c4a7e7",
      "color": "#2C2D2D",
      "format": "Void (btw)"
    },

    {
      "type": "host",
      "key": "⌂ ",
      "keyColor": "#c4a7e7",
      "color": "#2C2D2D",
      "format": "lethia's shitbox"
    },

    {
      "type": "shell",
      "format": "idk",
      "key": ">_",
      "keyColor": "#c4a7e7",
      "color": "#2C2D2D"
    },

    {
      "type": "terminal",
      "key": " ",
      "keyColor": "#c4a7e7",
      "color": "#2C2D2D"
    },

    {
      "type": "DE",
      "format": "xfce",
      "key": " ",
      "keyColor": "#c4a7e7",
      "color": "#2C2D2D"
    },

    {
      "type": "CPU",
      "key": "󰍛 ",
      "keyColor": "#c4a7e7",
      "color": "#2C2D2D",
      "format": "AMD Ryzen 5"
    },

    {
      "type": "GPU",
      "key": "󰢮 ",
      "keyColor": "#c4a7e7",
      "color": "#2C2D2D",
      "format": "AMD Radeon"
    },

    {
      "type": "memory",
      "key": "▦ ",
      "keyColor": "#c4a7e7",
      "color": "#2C2D2D",
      "format": "{} {}"
    },

    {
      "type": "uptime",
      "key": " ",
      "keyColor": "#c4a7e7",
      "color": "#2C2D2D"
    },

    "break",
    "break",
    "break"
  ]
}
